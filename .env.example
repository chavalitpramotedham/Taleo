# Server-side only. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-5-5)
# TALEO_MODEL=claude-opus-5-5

# Card payments for credits (Stripe Checkout). Leave both unset and
# buying credits says payments aren't open - nothing can be charged.
# STRIPE_SECRET_KEY: Stripe Dashboard > Developers > API keys (sk_test_...
# while testing, sk_live_... once the account is activated).
# STRIPE_WEBHOOK_SECRET: the signing secret (whsec_...) of the webhook
# destination pointing at https://<your site>/api/stripe/webhook, sent
# checkout.session.completed and checkout.session.async_payment_succeeded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
