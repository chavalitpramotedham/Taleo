# Server-side only. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-5-5)
# TALEO_MODEL=claude-opus-5-5

# Card payments for credits (Stripe Checkout). Leave both unset and
# buying credits says payments aren't open - nothing can be charged.
# STRIPE_SECRET_KEY: Stripe Dashboard > Developers > API keys (sk_test_...
# while testing, sk_live_... once the account is activated).
# STRIPE_WEBHOOK_SECRET: the signing secret (whsec_...) of the webhook
# destination pointing at https://<your site>/api/stripe/webhook, sent
# checkout.session.completed and checkout.session.async_payment_succeeded
# (and, for the Plus and Pro plans, the events listed below).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The Plus and Pro plans (monthly subscriptions). Leave these unset and
# the plans can't be bought yet - nothing can be charged. Each is the id
# (price_...) of a recurring monthly price made in Stripe's dashboard
# (Product catalogue: "Taleo Plus" at 16.99 SGD, "Taleo Pro" at 38.99 SGD,
# each product with a tax category). The webhook above must also be sent
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed,
# subscription_schedule.updated and subscription_schedule.released.
# Turn on the customer portal (Settings > Billing > Customer portal) with
# cancelling at the period's end, payment methods and invoice history.
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
