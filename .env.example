# Server-side only. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-5-5)
# TALEO_MODEL=claude-opus-5-5

# Optional on a developer's machine, REQUIRED on a deployed site: Upstash
# Redis (Vercel -> Storage -> Upstash for Redis sets these). Account
# profiles and everything else private live there; without it, a deployed
# site can't sign anyone in. Locally they fall back to files in .data/.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
